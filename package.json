{
  "name": "creed",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma personal de coaching f\u00edsico con Whoop + dos agentes AI",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "turbo run test:visual",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "db:start": ".bin/supabase start",
    "db:stop": ".bin/supabase stop",
    "db:status": ".bin/supabase status",
    "db:reset": ".bin/supabase db reset",
    "db:migration:new": ".bin/supabase migration new",
    "db:gen:types": ".bin/supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3"
  }
}
